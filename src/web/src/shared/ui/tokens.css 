:root {
  --color-bg: #ffffff;
  --color-surface: #f7f8fb;
  --color-surface-elevated: #ffffff;
  --color-ink: #0e0f13;
  --color-ink-dim: #5a5f72;
  --color-brand: #4f46e5;
  --color-brand-fg: #ffffff;
  --color-accent: #14b8a6;
  --color-danger: #dc2626;
  --color-success: #16a34a;
  --radius-sm: 6px; --radius-md: 10px; --radius-lg: 16px; --radius-xl: 24px;
  --shadow-sm: 0 1px 2px rgba(15,23,42,.06);
  --shadow-md: 0 4px 12px rgba(15,23,42,.08);
  --shadow-lg: 0 12px 40px rgba(15,23,42,.14);
  --duration-fast: 120ms; --duration-med: 220ms;
  --easing-standard: cubic-bezier(.2,.7,.2,1);
}
[data-theme="dark"] {
  --color-bg: #0b0d12;
  --color-surface: #12141b;
  --color-surface-elevated: #171923;
  --color-ink: #eef1f6;
  --color-ink-dim: #98a1b6;
}