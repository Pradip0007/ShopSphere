meta {
  name: Refresh customer tokens
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{customerRefreshToken}}"
  }
}

script:post-response {
  bru.setVar("customerAccessToken", res.body.accessToken);
  bru.setVar("customerRefreshToken", res.body.refreshToken);
}

tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("returns new access token", function() {
    expect(res.body.accessToken).to.be.a("string");
    expect(res.body.accessToken).to.not.equal(bru.getVar("customerAccessToken_prev") || "");
  });
}