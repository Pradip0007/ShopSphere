meta {
  name: Login customer
  type: http
  seq: 2
}

script:pre-request {
    console.log("LOGIN EMAIL:", bru.getVar("customerEmail"));
}
post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{customerEmail}}",
    "password": "{{customerPassword}}"
  }
}

script:post-response {
  bru.setVar("customerAccessToken", res.body.accessToken);
  bru.setVar("customerRefreshToken", res.body.refreshToken);
}

tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("returns access + refresh", function() {
    expect(res.body.accessToken).to.be.a("string");
    expect(res.body.refreshToken).to.be.a("string");
  });
  test("tokenType is Bearer", function() { expect(res.body.tokenType).to.equal("Bearer"); });
}