meta {
  name: Login admin
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  bru.setVar("adminAccessToken", res.body.accessToken);
}

tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("admin token issued", function() { expect(res.body.accessToken).to.be.a("string"); });
}